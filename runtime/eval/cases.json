{
  "note": "Labelled NEAR transactions for evaluating Preflight's deterministic risk flags. label: safe = fine to sign for a typical user; check = legitimate in some contexts, the user must confirm intent; danger = drainer/irreversible pattern a typical user should not sign. Written by the team; not an independent benchmark.",
  "cases": [
    { "id": "b1", "label": "safe", "why": "small NEAR transfer to a named account", "tx": { "receiver_id": "friend.testnet", "actions": [{ "type": "Transfer", "params": { "deposit": "1000000000000000000000000" } }] } },
    { "id": "b2", "label": "safe", "why": "FT transfer of a small amount with the 1 yocto security deposit", "tx": { "receiver_id": "usdc.fakes.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "ft_transfer", "args": { "receiver_id": "shop.testnet", "amount": "5000000" }, "gas": "30000000000000", "deposit": "1" } }] } },
    { "id": "b3", "label": "safe", "why": "storage deposit for a token", "tx": { "receiver_id": "wrap.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "storage_deposit", "args": { "account_id": "me.testnet" }, "gas": "30000000000000", "deposit": "1250000000000000000000" } }] } },
    { "id": "b4", "label": "safe", "why": "wrapping 2 NEAR", "tx": { "receiver_id": "wrap.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "near_deposit", "args": {}, "gas": "30000000000000", "deposit": "2000000000000000000000000" } }] } },
    { "id": "b5", "label": "safe", "why": "voting / view-like call with no deposit", "tx": { "receiver_id": "dao.sputnik.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "act_proposal", "args": { "id": 4, "action": "VoteApprove" }, "gas": "200000000000000", "deposit": "0" } }] } },
    { "id": "b6", "label": "safe", "why": "adding a function-call key limited to a game contract", "tx": { "receiver_id": "me.testnet", "actions": [{ "type": "AddKey", "params": { "publicKey": "ed25519:8hSHprDq2StXwMtNd43wDTXQYsjXcD4MJTXQYsjXcD4M", "accessKey": { "permission": { "receiverId": "game.testnet", "methodNames": ["move"], "allowance": "250000000000000000000000" } } } }] } },
    { "id": "b7", "label": "safe", "why": "claiming staking rewards", "tx": { "receiver_id": "pool.f863973.m0", "actions": [{ "type": "FunctionCall", "params": { "methodName": "withdraw_all", "args": {}, "gas": "50000000000000", "deposit": "0" } }] } },
    { "id": "b8", "label": "safe", "why": "NFT mint paying 0.1 NEAR", "tx": { "receiver_id": "nft.examples.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "nft_mint", "args": { "token_id": "7", "receiver_id": "me.testnet" }, "gas": "50000000000000", "deposit": "100000000000000000000000" } }] } },

    { "id": "d1", "label": "danger", "why": "adds a full-access key: classic drainer", "tx": { "receiver_id": "me.testnet", "actions": [{ "type": "AddKey", "params": { "publicKey": "ed25519:8hSHprDq2StXwMtNd43wDTXQYsjXcD4MJTXQYsjXcD4M", "accessKey": { "permission": "FullAccess" } } }] } },
    { "id": "d2", "label": "danger", "why": "unlimited ft_approve to an unknown spender", "tx": { "receiver_id": "usdc.fakes.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "ft_approve", "args": { "spender_id": "airdrop-claim.testnet", "amount": "340282366920938463463374607431768211455" }, "gas": "30000000000000", "deposit": "1" } }] } },
    { "id": "d3", "label": "danger", "why": "deletes the account, sending everything to a stranger", "tx": { "receiver_id": "me.testnet", "actions": [{ "type": "DeleteAccount", "params": { "beneficiaryId": "collector.testnet" } }] } },
    { "id": "d4", "label": "danger", "why": "deploys new code to the user's own account", "tx": { "receiver_id": "me.testnet", "actions": [{ "type": "DeployContract", "params": { "code": "AGFzbQEAAAA=" } }] } },
    { "id": "d5", "label": "danger", "why": "sends 50 NEAR to a 'verification' contract", "tx": { "receiver_id": "verify-wallet.testnet", "actions": [{ "type": "Transfer", "params": { "deposit": "50000000000000000000000000" } }] } },
    { "id": "d6", "label": "danger", "why": "AddKey + DeleteKey of the user's own key: account takeover", "tx": { "receiver_id": "me.testnet", "actions": [{ "type": "AddKey", "params": { "publicKey": "ed25519:8hSHprDq2StXwMtNd43wDTXQYsjXcD4MJTXQYsjXcD4M", "accessKey": { "permission": "FullAccess" } } }, { "type": "DeleteKey", "params": { "publicKey": "ed25519:CurrentUserKeyCurrentUserKeyCurrentUserKey1" } }] } },
    { "id": "d7", "label": "danger", "why": "transfers the user's whole FT balance to a lookalike name", "tx": { "receiver_id": "usdc.fakes.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "ft_transfer", "args": { "receiver_id": "binance-dep0sit.testnet", "amount": "9999999999999999999999999999" }, "gas": "30000000000000", "deposit": "1" } }] } },
    { "id": "d8", "label": "danger", "why": "nft_approve to an unknown marketplace for all-time control", "tx": { "receiver_id": "nft.examples.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "nft_approve", "args": { "token_id": "42", "account_id": "free-mint-promo.testnet" }, "gas": "30000000000000", "deposit": "450000000000000000000" } }] } },

    { "id": "a1", "label": "check", "why": "ft_transfer_call into a DEX: normal for swaps, but moves tokens into a contract", "tx": { "receiver_id": "usdc.fakes.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "ft_transfer_call", "args": { "receiver_id": "dex.testnet", "amount": "1000000", "msg": "{\"actions\":[]}" }, "gas": "150000000000000", "deposit": "1" } }] } },
    { "id": "a2", "label": "check", "why": "bounded approval of 100 tokens to a known DEX", "tx": { "receiver_id": "usdc.fakes.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "ft_approve", "args": { "spender_id": "dex.testnet", "amount": "100000000" }, "gas": "30000000000000", "deposit": "1" } }] } },
    { "id": "a3", "label": "check", "why": "listing an NFT on a marketplace via nft_transfer_call", "tx": { "receiver_id": "nft.examples.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "nft_transfer_call", "args": { "receiver_id": "market.testnet", "token_id": "42", "msg": "{\"price\":\"1\"}" }, "gas": "100000000000000", "deposit": "1" } }] } },
    { "id": "a4", "label": "check", "why": "15 NEAR transfer: fine if intended, large for most users", "tx": { "receiver_id": "landlord.testnet", "actions": [{ "type": "Transfer", "params": { "deposit": "15000000000000000000000000" } }] } },
    { "id": "a5", "label": "check", "why": "multisig / wallet execute: inner actions are opaque", "tx": { "receiver_id": "team-vault.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "w_execute_extension", "args": { "request": { "external": [] } }, "gas": "100000000000000", "deposit": "1" } }] } },
    { "id": "a6", "label": "check", "why": "staking 30 NEAR with a validator", "tx": { "receiver_id": "pool.f863973.m0", "actions": [{ "type": "FunctionCall", "params": { "methodName": "deposit_and_stake", "args": {}, "gas": "50000000000000", "deposit": "30000000000000000000000000" } }] } },
    { "id": "a7", "label": "check", "why": "storage_withdraw of everything from a contract", "tx": { "receiver_id": "wrap.testnet", "actions": [{ "type": "FunctionCall", "params": { "methodName": "storage_withdraw", "args": {}, "gas": "30000000000000", "deposit": "1" } }] } },
    { "id": "a8", "label": "check", "why": "removing one of the user's keys (could be cleanup, could lock them out)", "tx": { "receiver_id": "me.testnet", "actions": [{ "type": "DeleteKey", "params": { "publicKey": "ed25519:OldPhoneKeyOldPhoneKeyOldPhoneKeyOldPhone1" } }] } }
  ]
}
